<?xml version="1.0" encoding="utf-8"?>
<!--
  Never back up or device-transfer any app data: the stored URL is user-specific
  and the app is meant to be configured fresh on each device. (Android 12+ uses
  this file; android:allowBackup="false" covers older versions.)
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
